# ==========================================
# Root .gitignore for typbox-dev (Fullstack)
# ==========================================

# ------------------------------------------
# Operating System & General
# ------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ------------------------------------------
# IDE & Editors
# ------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*.sw?
*~
*.suo
*.ntvs*
*.njsproj
*.sln
*.local

# ------------------------------------------
# Environment Variables & Secrets
# ------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key

# ------------------------------------------
# Backend (Python & Django)
# ------------------------------------------
# Virtual Environments
.venv/
venv/
ENV/
env/
.env/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Django specifics
*.sqlite3
db.sqlite3
db.sqlite3-journal
*.sqlite3.bak*
media/
staticfiles/
local_settings.py

# Python tooling & Testing
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.cover
.tox/
.nox/

# ------------------------------------------
# Frontend (Node / Vite / React / TypeScript)
# ------------------------------------------
node_modules/
dist/
dist-ssr/
build/
*.tsbuildinfo
.eslintcache

# Package manager logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
