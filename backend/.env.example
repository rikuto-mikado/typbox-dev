# ==========================================
# TypBox Backend Environment Variables
# ==========================================

# Django Security
SECRET_KEY=
DEBUG=
ALLOWED_HOSTS=

# CORS & CSRF Settings (Comma-separated URLs of frontend clients)
CORS_ALLOWED_ORIGINS=

# Portfolio feed (/api/portfolio/feed/): whose logs, and how many recent days
PORTFOLIO_USERNAME=rikuto_dev
PORTFOLIO_FEED_DAYS=30

# Allow new sign-ups via /api/auth/register/ (closed by default)
ALLOW_REGISTRATION=False

# api.nasa.gov key for the Planetary Signal panel (https://api.nasa.gov/).
# Leave empty to fall back to the rate-limited DEMO_KEY.
NASA_API_KEY=
